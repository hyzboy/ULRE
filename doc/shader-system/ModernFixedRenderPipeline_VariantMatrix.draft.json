        ],
        "lightModel": [
          "BlinnPhong"
        ],
        "skyModel": [
          "FlatSimple",
          "AtmosphereSimple",
          "SH"
        ],
        "surfaceSet": [
          "S1",
          "S2",
          "S3"
        ],
        "shadow": [

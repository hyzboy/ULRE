          "PCF"
        ]
      }
    },
    "Medium": {
      "status": "Implemented",
      "allowed": {
        "renderPath": [
          "ForwardPixelLit",
          "MobileDeferredSubpass",
          "GBufferDeferred"
        ],
        "lightModel": [
          "BlinnPhong",
          "PBR"
        ],
        "skyModel": [

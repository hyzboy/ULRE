          "S3",
          "S4",
          "S5"
        ],
        "shadow": [
          "None",
          "PCF",
          "PCSS"
        ]
      },
      "fallbackSkyModelIfUnavailable": "AtmosphereSimple"
    }
  },
  "rules": {
    "validationOrder": [
      "platformTier",
      "tierWhitelist",
      "reservedCheck",
      "composerOwnershipCheck"
    ],
    "illegalCombination": {
      "editor": "ErrorWithAlternatives",
      "runtime": "FallbackNearestLegalPreferSameRenderPath"
    },
    "reservedCombination": {
      "editor": "FeatureNotAvailable",
      "runtime": "FallbackToSurfaceSet:S3"
    },
    "masking": {
      "ownership": "ComposerOwned",
      "businessLogicMayInjectCode": false,
      "hardMaskInjection": "ComposerInjectFixedThreshold",
      "ditherMaskInjection": "ComposerInjectFixedPatternWithFrameStability",
      "unsupportedPlatformFallback": [
        "HardMask",
        "Off"
      ]
    },
    "filamentReferenceOnly": true,
    "unrealSemanticAsPrimary": false
  },
  "cacheKeyFields": [
    "MaterialType",
    "RenderPath",
    "LightModel",
    "SkyModel",
    "SurfaceSet",
    "Platform",
    "Tier",
    "ShaderTemplateVersion"
  ],
  "exampleCacheKey": "BasicLit|GBufferDeferred|PBR|AtmosphereSimple|S4|PC-High|High|v3"
}

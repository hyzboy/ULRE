{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ulre.shadergen.result.v1",
  "title": "ShaderGenResult",
  "description": "Schema for offline/remote ShaderGen result package metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "cache_key",
    "layout",
    "vertex_layout",
    "buffer_structs",
    "spv_per_stage",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{16,128}$"
    },
    "result_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{16,128}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{16,128}$"
    },
    "cache_key": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings"],
      "properties": {
        "bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptor_binding" }
        }
      }
    },
    "vertex_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributes"],
      "properties": {
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/vertex_attribute" }
        }
      }
    },
    "buffer_structs": {
      "type": "array",
      "items": { "$ref": "#/$defs/buffer_struct" }
    },
    "spv_per_stage": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage_spv_blob" }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_error", "errors", "warnings"],
      "properties": {
        "has_error": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic_item" }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic_item" }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "build_time_utc": { "type": "string", "format": "date-time" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "descriptor_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "binding",
        "name",
        "resource_class",
        "stage_mask"
      ],
      "properties": {
        "set": { "type": "integer", "minimum": 0, "maximum": 255 },
        "binding": { "type": "integer", "minimum": 0, "maximum": 255 },
        "name": { "type": "string", "minLength": 1 },
        "resource_class": {
          "type": "string",
          "enum": [
            "UniformBuffer",
            "StorageBuffer",
            "SampledImage",
            "Sampler",
            "CombinedImageSampler",
            "InputAttachment",
            "StorageImage"
          ]
        },
        "type_name": { "type": "string" },
        "stage_mask": { "type": "integer", "minimum": 0 },
        "array_count": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "vertex_attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "semantic", "type_name", "input_rate"],
      "properties": {
        "location": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "semantic": { "type": "string", "minLength": 1 },
        "type_name": { "type": "string", "minLength": 1 },
        "input_rate": { "type": "string", "enum": ["vertex", "instance"] },
        "group": { "type": "string" }
      }
    },
    "buffer_struct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "members"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "offset", "size", "type_name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "offset": { "type": "integer", "minimum": 0 },
              "size": { "type": "integer", "minimum": 0 },
              "type_name": { "type": "string", "minLength": 1 },
              "array_size": { "type": "integer", "minimum": 1, "default": 1 }
            }
          }
        }
      }
    },
    "stage_spv_blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_mask", "spv_file", "byte_size", "spv_hash"],
      "properties": {
        "stage_mask": { "type": "integer", "minimum": 0 },
        "entrypoint": { "type": "string", "default": "main" },
        "spv_file": { "type": "string", "minLength": 1 },
        "byte_size": { "type": "integer", "minimum": 0 },
        "word_count": { "type": "integer", "minimum": 0 },
        "spv_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{16,128}$" }
      }
    },
    "diagnostic_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "code": { "type": "string" },
        "category": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error", "fatal"]
        },
        "message": { "type": "string", "minLength": 1 },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stage_mask": { "type": "integer", "minimum": 0 },
            "file": { "type": "string" },
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}

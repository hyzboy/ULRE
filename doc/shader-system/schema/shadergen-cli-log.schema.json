{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ulre.shadergen.cli.log.v1",
  "title": "ShaderGen CLI JSONL Log Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts_utc", "level", "code", "command", "message"],
  "properties": {
    "ts_utc": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error", "fatal"]
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "enum": ["generate", "pack", "verify"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "request_id": {
      "type": "string"
    },
    "material_key": {
      "type": "string"
    },
    "path": {
      "type": "string"
    }
  }
}

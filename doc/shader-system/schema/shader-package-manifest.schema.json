{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ulre.shader.package.manifest.v1",
  "title": "ShaderPackageManifest",
  "description": "Manifest schema for ShaderGen offline package bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_version",
    "manifest_version",
    "contract_version",
    "target",
    "quality",
    "hashes",
    "generator",
    "artifacts"
  ],
  "properties": {
    "package_version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+){0,2}$"
    },
    "manifest_version": {
      "type": "integer",
      "minimum": 1
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "graphics_api", "arch"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["windows", "linux", "macos", "android", "ios", "custom"]
        },
        "graphics_api": {
          "type": "string",
          "enum": ["vulkan", "dx12", "metal", "gles", "custom"]
        },
        "arch": {
          "type": "string",
          "enum": ["x86_64", "arm64", "custom"]
        }
      }
    },
    "quality": {
      "type": "string",
      "enum": ["low", "medium", "high", "ultra", "cinematic", "custom"]
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_hash", "result_hash", "content_hash"],
      "properties": {
        "request_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{16,128}$" },
        "result_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{16,128}$" },
        "content_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{16,128}$" }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "build_time_utc"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "build_time_utc": { "type": "string", "format": "date-time" },
        "toolchain": { "type": "string" },
        "host": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact_entry" }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "artifact_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "size", "hash"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(manifest\\.json|materials/.+)$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "manifest",
            "layout",
            "vertex",
            "spv",
            "diagnostics",
            "result_json",
            "custom"
          ]
        },
        "material_key": {
          "type": "string"
        },
        "stage_mask": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "hash": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{16,128}$"
        },
        "compression": {
          "type": "string",
          "enum": ["none", "zstd", "lz4", "custom"],
          "default": "none"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["none", "ed25519", "rsa-pss-sha256", "custom"]
        },
        "key_id": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

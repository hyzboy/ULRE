#Material
Name RectTexture2DArray
Base Std2D
Prim Triangles

#MaterialInstance
Length 16
Stage  Fragment
Code
{
    uvec4 id;
}

#VertexInput
vec2 TexCoord

#Vertex
Output
{
    vec2 TexCoord
}

Code
{
    void main()
    {
        HandoverMI();
        Output.TexCoord=TexCoord;

        gl_Position=GetPosition2D();
    }
}

#Fragment

sampler2DArray TextureBaseColor

Output
{
    vec4 FragColor;
}

Code
{
    void main()
    {
        MaterialInstance mi=GetMI();

        FragColor=texture(TextureBaseColor,vec3(Input.TexCoord,mi.id.x));
    }
}

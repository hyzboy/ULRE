    const uint char_idx = gl_WorkGroupID.x * {{group_size}}u + gl_LocalInvocationIndex;
    const uint base_vid = gl_LocalInvocationIndex * 4u;

    const uint total_chars = pc_vertex_index.total_vertices;
    const uint chars_this_group = min({{group_size}}u, total_chars - gl_WorkGroupID.x * {{group_size}}u);
    SetMeshOutputsEXT(chars_this_group * 4u, chars_this_group * 2u);

    if (char_idx >= total_chars)
        return;

    const CharInstanceData inst = sbo_char_instance.instances[char_idx];
    const int   pen_x    = (inst.pen_xy << 16) >> 16;
    const int   pen_y    = inst.pen_xy >> 16;
    const uint  char_id  = inst.char_style & 0xFFFFu;
    const uint  style_id = (inst.char_style >> 16) & 0xFFFFu;

    const TextCharInfo ci = sbo_char_info.chars[char_id];
    const int   mx = (ci.offset_xy << 16) >> 16;
    const int   my = ci.offset_xy >> 16;
    const uint  mw = ci.metrics_wh & 0xFFFFu;
    const uint  mh = (ci.metrics_wh >> 16) & 0xFFFFu;

    const CharStyleData cs = sbo_char_style.styles[style_id];

    const float char_scale = cs.scale;
    const int char_height = int(pc_vertex_index.char_height);
    const int mx_s = int(float(mx) * char_scale);
    const int my_s = int(float(my) * char_scale);
    const uint mw_s = uint(float(mw) * char_scale);
    const uint mh_s = uint(float(mh) * char_scale);

    // Rotation: compute center, rotate offsets, add pen + shear
    const float half_mw = float(mw_s) * 0.5;
    const float half_mh = float(mh_s) * 0.5;
    const float cx = float(mx_s) + half_mw;
    const float cy = float(-my_s) + float(char_height) * char_scale + half_mh;
    const int char_rot = cs.rotation + (inst.rotation & 0xFFFF);
    float r00 = 1.0, r01 = 0.0, r10 = 0.0, r11 = 1.0;
    if (char_rot == 90)       { r00 =  0.0; r01 =  1.0; r10 =  1.0; r11 =  0.0; }
    else if (char_rot == 180)  { r00 = -1.0; r01 =  0.0; r10 =  0.0; r11 = -1.0; }
    else if (char_rot == 270)  { r00 =  0.0; r01 = -1.0; r10 =  1.0; r11 =  0.0; }
    // TL offset from center
    float tl_dx = r00 * (-half_mw) - r01 * (-half_mh);
    float tl_dy = r10 * (-half_mw) + r11 * (-half_mh);
    // TR offset from center
    float tr_dx = r00 * (half_mw) - r01 * (-half_mh);
    float tr_dy = r10 * (half_mw) + r11 * (-half_mh);
    // BL offset from center
    float bl_dx = r00 * (-half_mw) - r01 * (half_mh);
    float bl_dy = r10 * (-half_mw) + r11 * (half_mh);
    // BR offset from center
    float br_dx = r00 * (half_mw) - r01 * (half_mh);
    float br_dy = r10 * (half_mw) + r11 * (half_mh);
    // Italic shear (relative to quad top, applied in local space before rotation)
    const float shear = tan(cs.italic);
    // Final positions: pen + rotated offset + shear offset
    const float pos_tl_x = float(pen_x) + cx + tl_dx + shear * (-half_mh - tl_dy);
    const float pos_tl_y = float(pen_y) + cy + tl_dy;
    const float pos_tr_x = float(pen_x) + cx + tr_dx + shear * (-half_mh - tr_dy);
    const float pos_tr_y = float(pen_y) + cy + tr_dy;
    const float pos_bl_x = float(pen_x) + cx + bl_dx + shear * (-half_mh - bl_dy);
    const float pos_bl_y = float(pen_y) + cy + bl_dy;
    const float pos_br_x = float(pen_x) + cx + br_dx + shear * (-half_mh - br_dy);
    const float pos_br_y = float(pen_y) + cy + br_dy;

    const vec2 uv_lt = unpackHalf2x16(ci.uv_lt);  // .x=left, .y=top
    const vec2 uv_rb = unpackHalf2x16(ci.uv_rb);  // .x=right, .y=bottom
    const float uv_l = uv_lt.x;
    const float uv_t = uv_lt.y;
    const float uv_r = uv_rb.x;
    const float uv_b = uv_rb.y;

    // UV: keep original (quad rotates, content follows)
    const float rot_tl_u = uv_l, rot_tl_v = uv_t;
    const float rot_tr_u = uv_r, rot_tr_v = uv_t;
    const float rot_bl_u = uv_l, rot_bl_v = uv_b;
    const float rot_br_u = uv_r, rot_br_v = uv_b;

    const vec4 char_color = unpackUnorm4x8(cs.text_color);

    // Triangle 1: TL, BL, TR
    gl_MeshVerticesEXT[base_vid + 0u].gl_Position = viewport.ortho_matrix * vec4(pos_tl_x, pos_tl_y, 0.0, 1.0);
    gl_MeshVerticesEXT[base_vid + 1u].gl_Position = viewport.ortho_matrix * vec4(pos_bl_x, pos_bl_y, 0.0, 1.0);
    gl_MeshVerticesEXT[base_vid + 2u].gl_Position = viewport.ortho_matrix * vec4(pos_tr_x, pos_tr_y, 0.0, 1.0);
    gl_MeshVerticesEXT[base_vid + 3u].gl_Position = viewport.ortho_matrix * vec4(pos_br_x, pos_br_y, 0.0, 1.0);

    gl_PrimitiveTriangleIndicesEXT[gl_LocalInvocationIndex * 2u + 0u] = uvec3(base_vid, base_vid + 1u, base_vid + 2u);
    gl_PrimitiveTriangleIndicesEXT[gl_LocalInvocationIndex * 2u + 1u] = uvec3(base_vid + 2u, base_vid + 1u, base_vid + 3u);


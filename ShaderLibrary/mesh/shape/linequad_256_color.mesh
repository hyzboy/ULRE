#version 460
// ShaderLibrary/mesh/shape/linequad_256_color.mesh
//
// 网格阶段「物理固定」主着色器 · 形状 = LineQuad（线段→四边形）+ varying{Color}(256/128)。
//
// 本文件**不随顶点格式 / 位置映射变化**：顶点解码（s1_*）与局部→裁剪变换
// （s2_* / s3_*）由 `generated/mesh_options.glsl` 注入。LineQuad 也不靠本文件
// 区分 3D / 2D —— 主体只调 `GetClipPos(GetLocalPos())`，映射家族由 options 决定
// （此前「按 Size / Color / TransformID 是否装载」分叉的预处理分支已随生成器
// 一起删除：缺属性由「换个 shape 名字（少一个 varying）」表达，
// 不再由同一份源里隐藏分支表达）。
//
// 形状差异只在 varying 集合：几何（端点读取 + 屏幕空间撑宽）住在
// `mesh/line_quad_body.glsl`，主体通过 `WriteLineQuadVertexOutputs()` 写 varying。
//
// 顶点色来源由 options 决定（直读 Color 流 / 调色板索引），两者都提供同签名的
// `vec4 GetVertexColor()`，因此本文件无需分支。
//
// 改本文件前请先读 doc/shadergen-elimination-domain-fixed-architecture.md。

#include "mesh/stage_common_head.glsl"

layout(local_size_x = 64) in;
layout(triangles, max_vertices = 256, max_primitives = 128) out;
#include "mesh/stage_common.glsl"

layout(location=HGL_LOCATION_VERTEX_COLOR) out vec4 fragVertexColor[256];

// 唯一可变输入：顶点解码 + 位置映射 + 变换
#include "generated/mesh_options.glsl"

void WriteLineQuadVertexOutputs(uint base_vid)
{
    const vec4 color = GetVertexColor();
    fragVertexColor[base_vid + 0u] = color;
    fragVertexColor[base_vid + 1u] = color;
    fragVertexColor[base_vid + 2u] = color;
    fragVertexColor[base_vid + 3u] = color;
}

#include "mesh/line_quad_body.glsl"

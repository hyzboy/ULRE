#version 460
// ShaderLibrary/mesh/shape/tri_192_pos_nrm.mesh
//
// 网格阶段「物理固定」主着色器 · 形状 = 世界位置 + 世界法线（VertexPassthrough 192/64）。
//
// 本文件**不随顶点格式 / 位置映射变化**：顶点解码（s1_*）与局部→裁剪变换
// （s2_* / s3_*）由 `generated/mesh_options.glsl` 注入，选项词表见
// inc/hgl/mtl/DomainOptions.h::EmitMeshOptions。新增一种顶点格式只需扩展 options，
// 不需要新增 .mesh 文件 —— 这正是「按 vertex format 生成形状键」被废除的原因。
//
// 形状键（形状 = varying 集合 + 拓扑）：15858600274526036172
//
// 输出 varying 集合必须与对应域 fragment 主着色器的输入集合逐 location 一致；
// 多一个或少一个都会在管线创建期被判接口不匹配。
//
// 改本文件前请先读 doc/shadergen-elimination-domain-fixed-architecture.md。

#include "mesh/stage_common_head.glsl"

layout(local_size_x = 64) in;
layout(triangles, max_vertices = 192, max_primitives = 64) out;
#include "mesh/stage_common.glsl"

layout(location=1) out vec3 fragWorldPos[192];
layout(location=2) out vec3 fragWorldNormal[192];

// 唯一可变输入：顶点解码 + 位置映射 + 变换
#include "generated/mesh_options.glsl"

void WriteMeshVertexOutputs(uint vid)
{
    fragWorldPos[vid] = GetWorldPos(GetLocalPos());
    fragWorldNormal[vid] = GetWorldNormal(Normal);
}

#define ULRE_MESH_MAX_VERTS 192u
#define ULRE_MESH_INVOCATIONS 64u
#include "mesh/stage_body.glsl"
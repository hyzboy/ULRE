#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(push_constant) uniform RootAddresses
{
    uint64_t addr_global_addresses;
    uint64_t addr_world_addresses;
    uint64_t addr_batch_mesh_draw_params;
    uint64_t addr_l2w;
    uint64_t addr_l2w_index;
    uint64_t addr_mtl_data_addrs;
    uint64_t addr_texture_references;
    uint64_t addr_text_char_info;
    uint64_t addr_text_char_style;
    uint64_t addr_text_char_instance;
    uint camera_row;
    uint _pad_camera;
} pc_root;

#define gl_InstanceIndex (draw_params.first_instance + gl_WorkGroupID.y)

layout(buffer_reference, scalar, buffer_reference_align=16) buffer LocalToWorldIndexRef { uint values[]; };
uint ResolveTransformID(uint iid) { return uint(LocalToWorldIndexRef(pc_root.addr_l2w_index).values[iid]); }
layout(local_size_x = 64) in;
layout(triangles, max_vertices = 192, max_primitives = 64) out;

#include "common/descriptor_macros.glsl"
#include "ubo/scene_ubo.glsl"
#include "common/l2w_ssbo.glsl"

// mesh shader：无 gl_VertexIndex；VertexIndexID = MeshVertexIndex（main 解析）
uint MeshVertexIndex;
#define VertexIndexID (MeshVertexIndex)

struct MeshDrawParams
{
    uint index_base;
    uint vertex_base;
    uint is_indexed;
    uint index_count;
    uint vertex_count;
    uint data_index_count;
    uint data_vertex_count;
    float char_height;
    uint first_instance;
    uint64_t addr_position;
    uint64_t addr_uv;
    uint64_t addr_ntb;
    uint64_t addr_color;
    uint64_t addr_luminance;
    uint64_t addr_transform_id;
    uint64_t addr_size;
    uint64_t addr_index;
};
layout(buffer_reference, scalar, buffer_reference_align=16) buffer MeshDrawParamsRef { MeshDrawParams rows[]; };

struct MeshDrawCommand
{
    uint geometry_id;
    uint first_instance;
};
layout(buffer_reference, scalar, buffer_reference_align=8) buffer MeshDrawCommandsRef { MeshDrawCommand cmds[]; };

MeshDrawParams draw_params;

layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexIndexRef       { uint data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexPositionRef    { vec3 data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexPositionV2Ref  { vec2 data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexPositionPackedRef { uint data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexUVRef          { vec2 data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexUVPackedRef    { uint data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexNTBRef         { vec3 data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexNTBPackedRef   { uint data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexColorRef       { vec4 data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexColorPackedRef { uint data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexLuminanceRef   { uint data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexTransformIDRef { uint data[]; };
layout(buffer_reference, scalar, buffer_reference_align=16) buffer VertexSizeRef        { vec2 data[]; };

#define sbo_vertex_index VertexIndexRef(draw_params.addr_index)

layout(location=0) perprimitiveEXT out uint fragDataIndexID[64];
layout(location=7) out float fragLuminance[192];
#include "vertex/s1_luminance.glsl"
#include "vertex/s1_position_vec3.glsl"
#include "vertex/s2_passthrough3d.glsl"

#include "vertex/s3_world_camera_vp.glsl"


void main()
{
    uint geometry_id = MeshDrawCommandsRef(pc_root.addr_batch_mesh_draw_params).cmds[gl_DrawID].geometry_id;
    draw_params = MeshDrawParamsRef(global_addresses.addr_mesh_draw_params_pool).rows[geometry_id];
    draw_params.first_instance = MeshDrawCommandsRef(pc_root.addr_batch_mesh_draw_params).cmds[gl_DrawID].first_instance;

    // 元素数：索引路径取 index_count、非索引路径取 vertex_count（旧 total_vertices 把两者混装）
    const uint total_vertices = (draw_params.is_indexed != 0u)
        ? draw_params.index_count
        : draw_params.vertex_count;
    const uint max_group_verts = 192u;
    const uint group_base_vertex = gl_WorkGroupID.x * max_group_verts;
    const uint raw_verts = (group_base_vertex < total_vertices)
        ? min(max_group_verts, total_vertices - group_base_vertex)
        : 0u;
    const uint prims_this_group = raw_verts / 3u;
    const uint verts_this_group = prims_this_group * 3u;

    SetMeshOutputsEXT(verts_this_group, prims_this_group);
    if (verts_this_group == 0u)
        return;

    for (uint vid = gl_LocalInvocationIndex; vid < verts_this_group; vid += 64u)
    {
        MeshVertexIndex = group_base_vertex + vid;
        if (draw_params.is_indexed != 0u)
            MeshVertexIndex = sbo_vertex_index.data[draw_params.index_base + MeshVertexIndex];

        LoadVertexData();
    fragDataIndexID[vid / 3u] = gl_InstanceIndex;
    fragLuminance[vid] = Luminance;
    gl_MeshVerticesEXT[vid].gl_Position = GetClipPos(GetLocalPos());
    }

    for (uint p = gl_LocalInvocationIndex; p < prims_this_group; p += 64u)
    {
        const uint bvid = p * 3u;
        gl_PrimitiveTriangleIndicesEXT[p] = uvec3(bvid, bvid + 1u, bvid + 2u);
    }
}

#version 460
// ShaderLibrary/mesh/fixed/14117761268391746788.mesh
//
// 物理固定的网格阶段主着色器：StandardOpaque masked shadow
//
// 形状键：14117761268391746788
// 覆盖的生产 fixture：lit-shadow-alpha
//
// 形状键由 GenericMaterialBuilder::ComputeMeshSourceShapeKey 从**已解析的**构建
// 计划算出（模式 / 位置格式 / 调用数 / Stage2-3 模块 / 变体标志 / stage interface），
// 因此同一键必须始终对应本文件，且本文件不得随 domain 或 recipe 名变化而拆分。
//
// 与生成器输出的等价性是逐字节的：ShaderDocumentProductionRegression 对
// source=fixed 的 fixture 断言 HashFinalShaderSource(final GLSL) 与生成器路径一致。
//
// local_size_x / max_vertices / max_primitives 是字面量而不是 options 常量：它们是
// CPU 侧调度契约（组内 64 线程、每组 192 顶点 = 64 三角形，CharQuad 为 256/128），
// 不是可运行时调节的选项。

#include "mesh/stage_common_head.glsl"

layout(local_size_x = 64) in;
layout(triangles, max_vertices = 192, max_primitives = 64) out;
#include "mesh/stage_common.glsl"

layout(location=0) perprimitiveEXT out uint fragDataIndexID[64];
layout(location=3) out vec2 fragUV0[192];
#include "vertex/s1_uv.glsl"
// Stage 1 位置解码：R32G32B32_SFLOAT（VAB 12B/顶点紧凑，scalar 布局）
#define sbo_vertex_position VertexPositionRef(draw_params.addr_position)
vec3 Position;

// 属性装载显式写死：不再经过 s1_* 的 HGL_*_LOADER 宏钩子，也不再有
// s1_position_* 内部的 8 个 #ifdef——固定源码不允许结构性条件编译。
void LoadVertexData()
{
    Position = sbo_vertex_position.data[draw_params.vertex_base + VertexIndexID];
    TexCoord = sbo_vertex_uv.data[draw_params.vertex_base + VertexIndexID];
}
#include "vertex/s2_passthrough3d.glsl"

#include "vertex/s3_world_camera_vp.glsl"


void main()
{
    uint geometry_id = MeshDrawCommandsRef(pc_root.addr_batch_mesh_draw_params).cmds[gl_DrawID].geometry_id;
    draw_params = MeshDrawParamsRef(global_addresses.addr_mesh_draw_params_pool).rows[geometry_id];
    draw_params.first_instance = MeshDrawCommandsRef(pc_root.addr_batch_mesh_draw_params).cmds[gl_DrawID].first_instance;

    // 元素数：索引路径取 index_count、非索引路径取 vertex_count（旧 total_vertices 把两者混装）
    const uint total_vertices = (draw_params.is_indexed != 0u)
        ? draw_params.index_count
        : draw_params.vertex_count;
    const uint max_group_verts = 192u;
    const uint group_base_vertex = gl_WorkGroupID.x * max_group_verts;
    const uint raw_verts = (group_base_vertex < total_vertices)
        ? min(max_group_verts, total_vertices - group_base_vertex)
        : 0u;
    const uint prims_this_group = raw_verts / 3u;
    const uint verts_this_group = prims_this_group * 3u;

    SetMeshOutputsEXT(verts_this_group, prims_this_group);
    if (verts_this_group == 0u)
        return;

    for (uint vid = gl_LocalInvocationIndex; vid < verts_this_group; vid += 64u)
    {
        MeshVertexIndex = group_base_vertex + vid;
        if (draw_params.is_indexed != 0u)
            MeshVertexIndex = sbo_vertex_index.data[draw_params.index_base + MeshVertexIndex];

        LoadVertexData();
        fragDataIndexID[vid / 3u] = gl_InstanceIndex;
        fragUV0[vid] = TexCoord;
        gl_MeshVerticesEXT[vid].gl_Position = GetClipPos(GetLocalPos());
    }

    for (uint p = gl_LocalInvocationIndex; p < prims_this_group; p += 64u)
    {
        const uint bvid = p * 3u;
        gl_PrimitiveTriangleIndicesEXT[p] = uvec3(bvid, bvid + 1u, bvid + 2u);
    }
}

#version 460
// ShaderLibrary/topology/linelist_128.mesh
//
// 网格阶段「物理固定」主着色器 · 线段 → 原生线图元（LineList，128 顶点 / 64 图元）。
//
// 与 `linequad_256.mesh` 同构，差别只在拓扑：`layout(lines)` 每线程发射 1 条
// 原生 Vulkan 线段（2 顶点 1 line），光栅化与经典 LINE_LIST 逐像素一致、
// 线宽恒 1px；LineQuad 的屏幕空间撑宽与 Size 顶点流在这里整个不存在。
//
// 本文件对「材质要传什么」完全无知：换材质只换 options，不换 .mesh。
// 开关来自 `generated/common_options.glsl`（inc/hgl/mtl/InterStageVaryingOptions.h），
// 声明（`module/stage/interstage_varying.glsl`）与写出钩子读同一批 `HGL_VARYING_*` 宏。
//
// include 顺序沿用 `tri_192.mesh` 的硬契约（见 mesh/stage_body.glsl）：
//   容量宏 → 公共头 → 拓扑 layout → 公共体 → varying 开关 → varying 声明
//   → options → 写出 → 主体。容量宏必须排在 varying 文件之前，它是数组维数。
//
// 三行 topology 字面量（local_size_x=64 / max_vertices=128 / max_primitives=64）
// 与 ResolveMeshModeTopology(LineList, 64) = 2N/N 契约绑定，由
// ValidateMeshSourceTopology 每次装配逐位比对，勿手改。
//
// 改本文件前请先读 doc/shadergen-elimination-domain-fixed-architecture.md。

#define ULRE_MESH_MAX_VERTS 128u
#define ULRE_MESH_MAX_PRIMITIVES 64u
#define ULRE_MESH_INVOCATIONS 64u
#define HGL_MESH_OUTPUT_VARYINGS

#include "module/stage/stage_common_head.glsl"

layout(local_size_x = 64) in;
layout(lines, max_vertices = 128, max_primitives = 64) out;
#include "module/stage/stage_common.glsl"

#include "generated/common_options.glsl"
#include "module/stage/interstage_varying.glsl"

// 唯一可变输入：顶点解码 + 位置映射 + 变换
#include "generated/mesh_options.glsl"

// 每条输入的线段只产生下面三条语义。其余语义若被材质打开，声明会出现而钩子不写 ——
// 数组留下未定义数据，屏幕上是随机值而不是报错。所以这里显式炸掉：
// 「线段画不了的东西」在编译期就该失败，而不是等画面上出花。
#if defined(HGL_VARYING_WORLD_POS) || defined(HGL_VARYING_WORLD_NORMAL) \
 || defined(HGL_VARYING_UV0) || defined(HGL_VARYING_STYLE_ID) \
 || defined(HGL_VARYING_FRAG_DIRECTION)
#error "linelist_128.mesh: 线段形状只输出 DataIndexID / Luminance / VertexColor，材质请求了它不产生的语义"
#endif

// 每条输入的线段出 2 个顶点、1 个线图元：`base_vid` 是首顶点槽位，两个顶点
// 共用同一份实例数据行与首端顶点属性（线的另一端只提供位置，不提供属性）。
void WriteLineListVertexOutputs(uint base_vid)
{
    const uint primitive_id = base_vid / 2u;
#if defined(HGL_VARYING_DATA_INDEX_ID)
    // 图元级（Flat）：线图的唯一槽写实例行号。
    fragDataIndexID[primitive_id] = gl_InstanceIndex;
#endif
#if defined(HGL_VARYING_LUMINANCE)
    const float luminance = Luminance;
    fragLuminance[base_vid + 0u] = luminance;
    fragLuminance[base_vid + 1u] = luminance;
#endif
#if defined(HGL_VARYING_VERTEX_COLOR)
    const vec4 color = GetVertexColor();
    fragVertexColor[base_vid + 0u] = color;
    fragVertexColor[base_vid + 1u] = color;
#endif
}

#include "module/stage/line_list_body.glsl"

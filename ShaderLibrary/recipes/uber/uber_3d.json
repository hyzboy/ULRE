{
  "name": "UberMaterial3D",
  "material_type": "Uber",
  "rendering_path": "Forward",
  "description": "万能不透明材质：TransformID+MI_ID 按 Instance 传递，纹理走 Texture2DArray。支持手机/PC 多质量等级。",

  "comment_permutation_axes": {
    "AMBIENT_MODEL": "0=FlatColor  1=Hemisphere  2=IBL  3=IBL_SH  4=MixedGI",
    "LIGHT_MODEL":   "0=Unlit  1=Lambert  2=BlinnPhong  3=PBR_Lite  4=PBR_Full  5=CelShading",
    "SPECULAR_SPLIT":"0=Combined  1=Separated(延迟G-Buffer)",
    "SHADOW_MODE":   "0=None  1=PCF  2=PCSS"
  },

  "quality_levels": {
    "mobile_low": {
      "description": "手机低配：无光照，纯颜色",
      "template": "forward_uber.frag.tmpl",
      "permutation": { "ambient": 0, "light": 0, "specular": 0, "shadow": 0 },
      "modules": {
        "lighting": null,
        "ambient":  null
      }
    },

    "mobile_high": {
      "description": "手机高配：Lambert 漫反射 + 平坦环境光",
      "template": "forward_uber.frag.tmpl",
      "permutation": { "ambient": 0, "light": 1, "specular": 0, "shadow": 0 },
      "modules": {
        "lighting": "lambert",
        "ambient":  null
      }
    },

    "pc_medium": {
      "description": "PC 中配：Blinn-Phong + 半球环境光 + PCF 阴影",
      "template": "forward_uber.frag.tmpl",
      "permutation": { "ambient": 1, "light": 2, "specular": 0, "shadow": 1 },
      "modules": {
        "lighting": "blinn_phong",
        "ambient":  "hemisphere"
      }
    },

    "pc_high": {
      "description": "PC 高配：PBR_Lite（暂用 half_lambert 占位）+ IBL_Simple + PCF 阴影（任务 3.3 完成后换 pbr_lite）",
      "template": "forward_uber.frag.tmpl",
      "permutation": { "ambient": 2, "light": 3, "specular": 0, "shadow": 1 },
      "modules": {
        "lighting": "half_lambert",
        "ambient":  "ibl_simple",
        "_todo": "task 3.3: 换为 pbr_lite 模块"
      }
    },

    "pc_ultra": {
      "description": "PC 超高配：完整 PBR + IBL + PCSS 软阴影 + 高光分离输出",
      "template": "forward_uber.frag.tmpl",
      "permutation": { "ambient": 2, "light": 4, "specular": 1, "shadow": 2 },
      "modules": {
        "lighting": "pbr_standard",
        "ambient":  "ibl"
      }
    },

    "cel_mobile": {
      "description": "卡通渲染手机版：CelShading + 平坦环境光",
      "template": "forward_uber.frag.tmpl",
      "permutation": { "ambient": 0, "light": 5, "specular": 0, "shadow": 0 },
      "modules": {
        "lighting": "cel_shading",
        "ambient":  null
      }
    }
  }
}

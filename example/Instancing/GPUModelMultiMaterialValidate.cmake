if(NOT DEFINED EXAMPLE OR NOT DEFINED RUNTIME_DIR)
    message(FATAL_ERROR "EXAMPLE and RUNTIME_DIR are required")
endif()

if(DEFINED COLD_SHADER_CACHE_ROOT)
    if(COLD_SHADER_CACHE_ROOT STREQUAL "" OR EXISTS "${COLD_SHADER_CACHE_ROOT}")
        message(FATAL_ERROR "COLD_SHADER_CACHE_ROOT must name a new, non-empty path")
    endif()
    file(TO_NATIVE_PATH "${COLD_SHADER_CACHE_ROOT}" cold_shader_cache_root)
    set(ENV{ULRE_SHADER_CACHE_PATH} "${cold_shader_cache_root}")
endif()

foreach(run 0 1 2)
    if(run EQUAL 2)
        set(cache 1)
        set(ENV{GMM_REVERSE_CREATE} 1)
    else()
        set(cache ${run})
        unset(ENV{GMM_REVERSE_CREATE})
    endif()
    foreach(var GMM_FRAMES GMM_SELFCHECK GMM_DUMP GMM_CASE
                ULRE_MAINFRAME_COLLECT_CACHE ULRE_MAINFRAME_TOPO_CACHE
                ULRE_REPLAY_PROBE ULRE_REPLAY_SKIP ULRE_BATCH_PROBE ULRE_NO_INSTANCING
                FRAMEDIGEST_PERFRAME)
        unset(ENV{${var}})
    endforeach()
    set(ENV{GMM_SELFCHECK} 1)
    set(ENV{GMM_FRAMES} 240)
    set(ENV{GMM_CASE} all)
    file(TO_NATIVE_PATH "${CMAKE_CURRENT_BINARY_DIR}/GPUModelMultiMaterial-run-${run}-failure.raw" dump)
    set(ENV{GMM_DUMP} "${dump}")
    set(ENV{ULRE_MAINFRAME_COLLECT_CACHE} ${cache})
    set(ENV{ULRE_MAINFRAME_TOPO_CACHE} ${cache})
    execute_process(COMMAND "${EXAMPLE}"
        WORKING_DIRECTORY "${RUNTIME_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors
        TIMEOUT 120)
    set(log "${output}\n${errors}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/GPUModelMultiMaterial-run-${run}.log" "${log}")
    if(NOT result STREQUAL "0" OR NOT log MATCHES "\\[GMM\\] PASS")
        message(FATAL_ERROR "Multi-material cache=${cache} failed (${result}):\n${log}")
    endif()
    string(REGEX MATCHALL "[^\n]*GMM expected placeholder retry fixture[^\n]*" expected_failures "${log}")
    list(LENGTH expected_failures expected_count)
    if(NOT expected_count EQUAL 2)
        message(FATAL_ERROR "Texture retry fixture did not exercise exactly two expected failures")
    endif()
    string(REGEX REPLACE "[^\n]*GMM expected placeholder retry fixture[^\n]*" "" checked_log "${log}")
    foreach(diagnostic
            "\\[DestroyMultiMaterialModelTemplate\\] Template still has live instances: [0-9]+"
            "\\[ActiveRowPool\\] AcquireRun exceeded capacity: [^\n]*count=3 capacity=[0-9]+"
            "\\[BuildMultiMaterialModelTemplate\\] ModelPartPool[^\n]*count=3")
        string(REGEX MATCHALL "[^\n]*${diagnostic}[^\n]*" expected "${checked_log}")
        list(LENGTH expected count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Missing or repeated expected rollback diagnostic: ${diagnostic}")
        endif()
        string(REGEX REPLACE "[^\n]*${diagnostic}[^\n]*" "" checked_log "${checked_log}")
    endforeach()
    if(checked_log MATCHES "VUID-|SYNC-HAZARD|hazard detected|\\[ERROR\\]|\\[FATAL\\]|group skipped|Skip primitive item|\\[ObjectLogger:[0-9]+\\]\\[[^\n]+\\.cpp:[0-9]+\\]")
        message(FATAL_ERROR "Multi-material cache=${cache} reported a rendering error:\n${log}")
    endif()
    string(REGEX MATCHALL "\\[GMM\\] FRAME phase=[0-9]+ sample=[0-9]+ hash=[0-9a-fA-F]+" frames "${log}")
    list(LENGTH frames frame_count)
    if(frame_count LESS 51 OR NOT log MATCHES "\\[GMM\\] MIPMAP variants ready"
       OR NOT log MATCHES "\\[GMM\\] LIFETIME cycle=3"
       OR NOT log MATCHES "\\[GMM\\] ROLLBACK live destroy rejected")
        message(FATAL_ERROR "Multi-material cache=${cache} did not complete all acceptance samples")
    endif()
    if(cache EQUAL 1 AND NOT log MATCHES "\\[GMM\\] CACHE hits=[1-9][0-9]*")
        message(FATAL_ERROR "Cache enabled but the collection path never replayed")
    endif()
    if(run EQUAL 0)
        set(baseline "${frames}")
    elseif(NOT frames STREQUAL baseline)
        message(FATAL_ERROR "Cache replay changed multi-material phase pixels:\n${frames}\nvs\n${baseline}")
    endif()
endforeach()
message(STATUS "GPUModelMultiMaterial: per-part pixels, GPU material routes and cache parity passed")

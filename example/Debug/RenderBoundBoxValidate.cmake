if(NOT DEFINED EXAMPLE OR NOT DEFINED RUNTIME_DIR)
    message(FATAL_ERROR "EXAMPLE and RUNTIME_DIR are required")
endif()

foreach(var ULRE_NO_INSTANCING ULRE_REPLAY_PROBE ULRE_REPLAY_SKIP ULRE_BATCH_PROBE)
    unset(ENV{${var}})
endforeach()
set(ENV{RBB_SELFCHECK} 1)
foreach(cache 0 1)
    set(ENV{ULRE_MAINFRAME_COLLECT_CACHE} ${cache})
    set(ENV{ULRE_MAINFRAME_TOPO_CACHE} ${cache})
    execute_process(COMMAND "${EXAMPLE}"
        WORKING_DIRECTORY "${RUNTIME_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
    set(log "${output}\n${errors}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/RenderBoundBox-cache-${cache}.log" "${log}")
    if(NOT result STREQUAL "0" OR NOT log MATCHES "\\[RBB\\] PASS")
        message(FATAL_ERROR "Wireframe cache=${cache} failed (${result}):\n${log}")
    endif()
    if(log MATCHES "VUID-|SYNC-HAZARD|hazard detected|Skip primitive item|group skipped|\\[ObjectLogger:[0-9]+\\]\\[[^\n]+\\.cpp:[0-9]+\\]")
        message(FATAL_ERROR "Wireframe cache=${cache} reported an unexpected rendering error:\n${log}")
    endif()
    string(REGEX MATCHALL "\\[RBB\\] FRAME sample=[0-9]+ hash=[0-9a-fA-F]+" frames "${log}")
    list(LENGTH frames frame_count)
    if(NOT frame_count EQUAL 3)
        message(FATAL_ERROR "Wireframe cache=${cache} did not complete all samples")
    endif()
    if(cache EQUAL 0)
        set(baseline "${frames}")
    elseif(NOT frames STREQUAL baseline)
        message(FATAL_ERROR "Wireframe cache replay changed rendered frame pixels")
    endif()
endforeach()
message(STATUS "RenderBoundBox line topology and frame parity passed with cache off/on")
